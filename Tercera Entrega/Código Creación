CREATE TABLE CLASIFICA (
ID_libro int,
ID_categoria int,

PRIMARY KEY (ID_libro, ID_categoria),
FOREIGN KEY (ID_libro) REFERENCES LIBRO(ID_libro),	
FOREIGN KEY (ID_categoria) REFERENCES CATEGORIA(ID_categoria)
);

CREATE TABLE ESCRIBE (
ID_libro int,
ID_autor int,

PRIMARY KEY (ID_libro, ID_autor),
FOREIGN KEY (ID_libro) REFERENCES LIBRO(ID_libro),
FOREIGN KEY (ID_autor) REFERENCES AUTOR(ID_autor)
);

CREATE TABLE PUBLICA (
ID_libro int,
NIT int,

PRIMARY KEY (ID_libro, NIT),
FOREIGN KEY (ID_libro) REFERENCES LIBRO(ID_libro),
FOREIGN KEY (NIT) REFERENCES EDITORIAL(NIT)
);

CREATE TABLE B_VIRTUAL (
ID_sede int,
Ubicacion_web varchar(250) not null,

PRIMARY KEY (ID_sede),
FOREIGN KEY (ID_sede) REFERENCES BIBLIOTECA(ID_sede)
);

CREATE TABLE B_FISICA (
ID_sede int,
Telefono varchar(20) not null,
Direccion varchar(250) not null,

PRIMARY KEY (ID_sede),
FOREIGN KEY (ID_sede) REFERENCES BIBLIOTECA(ID_sede)
);

CREATE TABLE USUARIO (
ID_usuario int,
Telefono varchar(20) not null,
Direccion varchar(250) not null,
Nombre varchar(100) not null,
ID_sede int,

PRIMARY KEY (ID_usuario),
FOREIGN KEY (ID_sede) REFERENCES BIBLIOTECA(ID_sede)
);

CREATE TABLE RESERVA (
ID_reserva int,
Fecha_devolucion date not null,
Fecha_prestamo date not null,
ID_usuario int,
ID_ejemplar int,

PRIMARY KEY (ID_reserva),
FOREIGN KEY (ID_usuario) REFERENCES USUARIO(ID_usuario),
FOREIGN KEY (ID_ejemplar) REFERENCES EJEMPLARES(ID_ejemplar)
);

CREATE TABLE RENOVARSE (
ID_renovacion int,
Fecha_vencimiento date not null,
Fecha_solicitud date not null,
ID_reserva int,

PRIMARY KEY (ID_renovacion),
FOREIGN KEY (ID_reserva) REFERENCES RESERVA(ID_reserva)
);

CREATE TABLE ESTUDIANTE (
ID_usuario int,

PRIMARY KEY (ID_usuario),
FOREIGN KEY (ID_usuario) REFERENCES USUARIO(ID_usuario)
);

CREATE TABLE DOCENTE (
ID_usuario int,

PRIMARY KEY (ID_usuario),
FOREIGN KEY (ID_usuario) REFERENCES USUARIO(ID_usuario)
);

CREATE TABLE SANCIONA (
ID_sancion int,
Fecha_inicio date not null,
Motivo varchar(100) not null,
Fecha_fin date not null,
ID_usuario int,

PRIMARY KEY (ID_sancion),
FOREIGN KEY (ID_usuario) REFERENCES USUARIO(ID_usuario)
);
