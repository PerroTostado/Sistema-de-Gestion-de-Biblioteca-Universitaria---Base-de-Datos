CREATE TABLE AUTOR (
ID_autor int,
Fecha_nacimiento Date not null,
Fecha_fallecido Date,
Nombre varchar(100) not null,
 
PRIMARY KEY (ID_autor)
);

CREATE TABLE CATEGORIA (
ID_categoria int,
Nombre varchar(100) not null,
Descripcion varchar(250) not null,
 
PRIMARY KEY (ID_categoria)
);

CREATE TABLE LIBRO (
ID_libro int,
Nro_paginas int not null,
Titulo varchar(100) not null,
Idioma varchar(30) not null,
 
PRIMARY KEY (ID_libro)
);

CREATE TABLE EDITORIAL (
NIT int,
Nombre varchar(100),
Pais varchar(30),
 
PRIMARY KEY (NIT)
);

CREATE TABLE BIBLIOTECA (
ID_sede int,
Nombre varchar(100),
 
PRIMARY KEY (ID_sede)
);

CREATE TABLE UBICACION (
ID_ubicacion int,
Estanteria int not null,
Piso int not null,
Sección varchar(100) not null,
ID_Sede int not null,
 
PRIMARY KEY (ID_ubicacion ),
FOREIGN KEY (ID_Sede) REFERENCES BIBLIOTECA(ID_sede)
);

CREATE TABLE EJEMPLARES (
ID_ejemplar int,
ID_libro int not null,
ID_ubicacion int not null,
 
PRIMARY KEY (ID_ejemplar),
FOREIGN KEY (ID_libro) REFERENCES LIBRO(ID_libro),
FOREIGN KEY (ID_ubicacion) REFERENCES UBICACION(ID_ubicacion)
);

CREATE TABLE E_VIRTUAL (
ID_ejemplar int,
URL varchar(250) not null,
Licencia Date not null,
 
PRIMARY KEY (ID_ejemplar),
FOREIGN KEY (ID_ejemplar) REFERENCES EJEMPLARES(ID_ejemplar)
);

CREATE TABLE E_FISICO (
ID_ejemplar int,
Cod_barras int not null UNIQUE,
Estado int not null,
 
PRIMARY KEY (ID_ejemplar),
FOREIGN KEY (ID_ejemplar) REFERENCES EJEMPLARES(ID_ejemplar)
);


